    subgraph "CRM System"
        UC1([Authenticate])
        UC2([Manage Clients])
        UC3([Create Deal])
        UC4([Select Client])
        UC5([Select Products])
        UC6([Apply Discount])
        UC7([Manage Products])
        UC8([View Deal History])
        UC9([Manage Users])
        UC10([Generate Report])
    end

    M --> UC2
    M --> UC3
    M --> UC7
    M --> UC8
    M --> UC10
    C --> UC8
    A --> UC9
    A --> UC10

    UC2 -.->|include| UC1
    UC3 -.->|include| UC1
    UC3 -.->|include| UC4
    UC3 -.->|include| UC5
    UC3 -.->|extend| UC6
    UC7 -.->|include| UC1
    UC8 -.->|include| UC1
    UC9 -.->|include| UC1
    UC10 -.->|include| UC1

    A -.->|generalizes| M
